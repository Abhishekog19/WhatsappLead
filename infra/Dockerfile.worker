# syntax=docker/dockerfile:1
#
# Worker tier, and the one-shot migration container (same image, different
# command — see infra/docker-compose.yml).
#
# Unlike the web image there is no bundling step. The worker runs its
# TypeScript directly through tsx: the packages in this monorepo are published
# as source rather than build output, the worker is a long-lived process where
# a few hundred milliseconds of startup transpilation is irrelevant, and it
# keeps the deployed code byte-identical to the repository.

FROM node:22-alpine AS base
ENV PUPPETEER_SKIP_DOWNLOAD=1
WORKDIR /app


# ---------- dependencies ------------------------------------------------------
FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/

# Dev dependencies are kept: tsx and drizzle-kit are what actually run here.
# --ignore-scripts skips the legacy script's Chromium download.
RUN npm ci --ignore-scripts


# ---------- runtime -----------------------------------------------------------
FROM base AS runtime
ENV NODE_ENV=production

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json ./
COPY --chown=node:node tsconfig.base.json ./
COPY --chown=node:node packages ./packages
COPY --chown=node:node apps/worker ./apps/worker

USER node
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Node is PID 1 and receives SIGTERM directly, so the graceful shutdown in
# apps/worker/src/index.ts actually runs. Going through `npm run` would put npm
# in between, and npm does not forward signals reliably.
CMD ["node", "--import", "tsx", "apps/worker/src/index.ts"]
