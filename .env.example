# ==============================================================
# Copy to .env and fill in. NEVER commit the filled-in .env.
#
#   cp .env.example .env
#
# Both the containers (env_file) and docker-compose.yml's own ${...}
# interpolation read this one file, which is why it lives at the repo root.
# ==============================================================

# ---------- Database ----------
#
# Local dev: anything reachable. A free Neon project is fine HERE, because the
#   worker is usually not running; see the warning in docs/DEPLOYMENT.md about
#   its compute-hour allowance before using it for a deployment.
#
# Render + Supabase: use the SHARED POOLER, not the direct connection —
#   Supabase's direct connections are IPv6-only on the free plan. The pooler
#   requires a project-qualified username, so the role is "wa_app.PROJECT_REF"
#   rather than "wa_app":
#
#     postgresql://wa_app.abcdefghijklmno:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
#   Port 5432 is session mode, 6543 is transaction mode. Either works — tenant
#   context is set transaction-locally — but copy the host from the Supabase
#   dashboard rather than assembling it: the "aws-0" part is a pooler index,
#   not a region.
#
# Docker Compose: leave this as-is. compose overrides it with the in-network
#   address of the postgres container.
DATABASE_URL=postgres://user:password@host:5432/wa

# Password for the Postgres container. Only used by docker compose.
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# Password for wa_app, the role the web app and worker connect as.
#
# Separate from POSTGRES_PASSWORD on purpose. The superuser owns the schema and
# runs migrations; the app uses this unprivileged role, because Postgres
# exempts superusers from row-level security and an app connecting as one would
# have every tenant-isolation policy silently skipped. The worker refuses to
# start if it detects that, and /api/health reports it.
POSTGRES_APP_PASSWORD=

# ---------- Secrets ----------
# Encrypts WhatsApp session credentials at rest (AES-256-GCM).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LOSING THIS MEANS EVERY LINKED WHATSAPP ACCOUNT MUST RE-PAIR.
CREDS_ENCRYPTION_KEY=

# Signs Auth.js session cookies.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ---------- Google OAuth ----------
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod): https://your-domain.com/api/auth/callback/google
#
# The worker validates the same environment contract as the web app, so it
# wants these set too even though it never performs a login.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------- App ----------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ---------- Deployment (docker compose only) ----------
# Public hostname. Caddy requests a certificate for exactly this name, so DNS
# must already point at the host. Compose builds APP_URL from it.
DOMAIN=
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=

# ---------- Worker ----------
# How often the scheduler wakes to ask "what is due to send right now?"
WORKER_TICK_MS=5000
# Port for the worker's own /health endpoint. Internal: never published.
# On Render it must differ from the injected PORT, and must avoid the ports
# Render reserves (18012, 18013, 19099).
WORKER_HEALTH_PORT=3001

# Local bootstrap only. Never add owner credentials to Render.
# MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Optional Supabase project CA in PEM format (literal newlines or escaped \n).
# DATABASE_SSL_CA=
# Engine driving WhatsApp. 'baileys' (default, browserless) or 'wwebjs' (fallback).
WA_ENGINE=baileys

# ---------- Resource budget ----------
#
# The whole platform — website, worker and every WhatsApp socket — shares one
# container. On Render's free instance that is 512 MB of RAM and 0.1 CPU, so
# these are a real budget rather than tuning knobs.
#
# Pool sizes are PER PROCESS and there are two processes, so the database sees
# up to WEB_DB_POOL + WORKER_DB_POOL connections from this service.
WEB_DB_POOL=3
WORKER_DB_POOL=3

# Spreadsheet limits. Parsing is not streamed — the workbook is held in memory
# — so the file-size cap is really a memory cap. 4 MB of XLSX becomes roughly
# ten times that once parsed.
MAX_UPLOAD_MB=4
MAX_IMPORT_ROWS=5000
# Imports are serialised by default: two at once is the likeliest way to run
# the container out of memory, and the host's response to that is to kill it.
MAX_CONCURRENT_IMPORTS=1

# ---------- Platform safety ceiling ----------
# Hard upper bound on NEW contacts per rolling 24h, above any user setting.
# Protects the platform from a single account being configured into abuse.
PLATFORM_MAX_NEW_CONTACTS_24H=120
